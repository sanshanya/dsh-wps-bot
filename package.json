{
  "name": "dsh-wps-bot",
  "version": "0.0.1",
  "description": "WPS 365 chat bot channel plugin for DeepSeek Harness (dsh): drive your agent from WPS group chats (open-event-sdk long connection, markdown/cards, consents with timed windows)",
  "type": "module",
  "license": "MIT",
  "author": "sanshanya",
  "private": false,
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./bot": {
      "types": "./lib/bot.d.ts",
      "default": "./lib/bot.js"
    },
    "./protocol": {
      "types": "./lib/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./client": "./lib/browser.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "examples/wps-bot.cordis.yml",
    "README.md",
    "LICENSE",
    "skills",
    "scripts/wps-chat.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "survey:tokens": "node scripts/token-survey.mjs",
    "budget:tokens": "node scripts/token-budget.mjs",
    "build": "npm run build:lib && npm run build:client",
    "prepublishOnly": "npm run build && npm run verify:pack",
    "verify:pack": "node scripts/verify-pack.mjs",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "open-event-sdk": "^1.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0 || ^19.0.0",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "js-tiktoken": "^1.0.21",
    "react": "^19.2.8",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sanshanya/dsh-wps-bot.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "wps",
    "wps365",
    "kingsoft",
    "channel",
    "bot"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    }
  }
}
